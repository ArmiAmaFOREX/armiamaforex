<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Replica la strategia ArmiAma FOREX Strategies sul tuo conto FP Markets: copy trading su infrastruttura regolamentata MiFID II, fondi sul tuo conto personale, sospendi o revochi la copia quando vuoi.">
  <title>Programma Master e Copy Trading regolamentato | ArmiAma Forex</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --gold: #d4a017;
      --gold-light: #e8c96d;
      --gold-dim: rgba(201,168,76,0.15);
      --bg: #090b0e;
      --bg2: #0e1117;
      --bg3: #141820;
      --text: #e8e4dc;
      --muted: #7a7569;
      --accent: #1aff9c;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'DM Mono', monospace;
      overflow-x: hidden;
    }

    /* NOISE TEXTURE */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 999;
      opacity: 0.6;
    }

    /* TICKER */
    .ticker-wrap {
      background: var(--gold);
      overflow: hidden;
      white-space: nowrap;
      padding: 8px 0;
    }
    .ticker {
      display: inline-block;
      animation: ticker 30s linear infinite;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      color: #090b0e;
    }
    @keyframes ticker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* NAV */
    nav {
      position: sticky;
      top: 0;
      z-index: 200;
      background: rgba(9,11,14,0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(201,168,76,0.2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 48px;
    }
    .nav-logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 28px;
      letter-spacing: 0.08em;
      color: var(--gold);
    }
    .nav-logo span { color: var(--text); }
    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }
    .nav-links a {
      color: var(--text);
      text-decoration: none;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      transition: color 0.3s;
    }
    .nav-links a:hover { color: var(--gold); }

    /* SUBMENU (desktop: hover dropdown) */
    .has-submenu { position: relative; }
    .nav-sub-toggle {
      background: none;
      border: none;
      color: var(--text);
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.3s;
    }
    .nav-sub-toggle:hover, .has-submenu:hover .nav-sub-toggle { color: var(--gold); }
    .chevron { font-size: 9px; transition: transform 0.25s; }
    .nav-submenu {
      display: none;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .has-submenu:hover .nav-submenu {
      display: block;
      position: absolute;
      top: calc(100% + 16px);
      left: 50%;
      transform: translateX(-50%);
      background: #0d0f13;
      border: 1px solid rgba(201,168,76,0.25);
      box-shadow: 0 16px 32px rgba(0,0,0,0.5);
      min-width: 220px;
      padding: 6px 0;
      z-index: 210;
    }
    /* invisible bridge: keeps the li "hovered" while the cursor crosses
       the visual gap between the button and the dropdown panel below it */
    .has-submenu::after {
      content: "";
      position: absolute;
      top: 100%;
      left: -20px;
      right: -20px;
      height: 20px;
    }
    .has-submenu:hover .chevron { transform: rotate(180deg); }
    .nav-submenu li a {
      display: block;
      padding: 12px 20px;
      font-size: 10.5px;
      white-space: nowrap;
    }
    .nav-cta {
      background: var(--gold);
      color: #090b0e;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 10px 22px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.25s, transform 0.2s;
      display: inline-block;
    }
    .nav-cta:hover { background: var(--gold-light); transform: translateY(-1px); }

    /* HERO */
    .hero {
      min-height: 92vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 80px 48px;
      gap: 60px;
      position: relative;
      overflow: hidden;
      background-size: cover;
      background-position: center 30%;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(4,5,7,1) 0%, rgba(4,5,7,0.96) 30%, rgba(4,5,7,0.7) 55%, rgba(4,5,7,0.2) 80%);
      pointer-events: none;
      z-index: 1;
    }

    /* BG GRID */
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    /* GLOW */
    .hero-glow {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,168,76,0.12) 0%, transparent 70%);
      top: -100px;
      left: -100px;
      pointer-events: none;
    }

    .hero-left { position: relative; z-index: 2; }

    .hero-tag {
      display: inline-block;
      border: 1px solid var(--gold);
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      padding: 6px 14px;
      margin-bottom: 28px;
      animation: fadeUp 0.8s ease both;
    }

    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(64px, 8vw, 110px);
      line-height: 0.92;
      letter-spacing: 0.02em;
      color: var(--text);
      text-shadow: 0 2px 20px rgba(0,0,0,0.6);
      animation: fadeUp 0.8s ease 0.1s both;
    }
    .hero-title .gold { color: var(--gold); display: block; }

    .hero-sub {
      margin-top: 28px;
      font-size: 13px;
      line-height: 1.8;
      color: var(--gold);
      max-width: 420px;
      text-shadow: 0 1px 12px rgba(0,0,0,0.7);
      animation: fadeUp 0.8s ease 0.2s both;
    }

    .hero-actions {
      margin-top: 44px;
      display: flex;
      gap: 16px;
      align-items: center;
      animation: fadeUp 0.8s ease 0.3s both;
    }

    .btn-primary {
      background: var(--gold);
      color: #090b0e;
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 14px 32px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s;
      display: inline-block;
    }
    .btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); box-shadow: 0 12px 32px rgba(201,168,76,0.3); }

    .btn-ghost {
      background: transparent;
      color: var(--text);
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 14px 28px;
      border: 1px solid rgba(255,255,255,0.15);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s;
      display: inline-block;
    }
    .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

    /* CHART ANIMATION */
    .hero-right {
      position: relative;
      z-index: 2;
      animation: fadeIn 1.2s ease 0.4s both;
    }

    .chart-card {
      background: rgba(14,17,23,0.55);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(201,168,76,0.2);
      padding: 32px;
      position: relative;
      overflow: hidden;
    }
    .chart-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--gold), transparent);
    }

    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
    }
    .chart-pair {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 36px;
      color: var(--text);
      letter-spacing: 0.05em;
    }
    .chart-price {
      text-align: right;
    }
    .chart-price .price {
      font-size: 28px;
      color: var(--accent);
      font-weight: 500;
    }
    .chart-price .change {
      font-size: 11px;
      color: var(--accent);
      opacity: 0.8;
    }

    /* SVG Chart */
    .chart-svg {
      width: 100%;
      height: 140px;
    }

    .chart-line {
      fill: none;
      stroke: var(--gold);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 800;
      stroke-dashoffset: 800;
      animation: drawLine 2.5s ease 0.8s forwards;
    }
    .chart-area {
      fill: url(#chartGrad);
      opacity: 0;
      animation: fadeIn 1s ease 3s forwards;
    }
    @keyframes drawLine {
      to { stroke-dashoffset: 0; }
    }

    .chart-footer {
      display: flex;
      gap: 24px;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .chart-stat { flex: 1; }
    .chart-stat .label {
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .chart-stat .val {
      font-size: 18px;
      color: var(--text);
    }

    /* STATS ROW */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgba(201,168,76,0.15);
      border-bottom: 1px solid rgba(201,168,76,0.15);
    }
    .stat-block {
      padding: 48px;
      text-align: center;
      border-right: 1px solid rgba(201,168,76,0.15);
      position: relative;
      overflow: hidden;
      transition: background 0.3s;
    }
    .stat-block:last-child { border-right: none; }
    .stat-block:hover { background: var(--gold-dim); }
    .stat-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 64px;
      color: var(--gold);
      line-height: 1;
      letter-spacing: 0.02em;
    }
    .stat-label {
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 8px;
    }

    /* SECTION */
    section { padding: 100px 48px; }
    .section-label {
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 16px;
    }
    .section-title {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.15;
      color: var(--text);
      max-width: 600px;
    }
    .section-title em { color: var(--gold); font-style: italic; }

    /* CONTENT GRID */
    .content-section {
      background: var(--bg2);
    }
    .content-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      margin-top: 60px;
    }
    .content-text p {
      font-size: 14px;
      line-height: 2;
      color: var(--muted);
      margin-bottom: 20px;
    }

    .video-card {
      background: var(--bg3);
      border: 1px solid rgba(201,168,76,0.15);
      aspect-ratio: 9/16;
      max-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: border-color 0.3s;
    }
    .video-card:hover { border-color: var(--gold); }
    .video-card:hover .play-btn { transform: scale(1.1); }

    .video-bg-pattern {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        45deg,
        rgba(201,168,76,0.03),
        rgba(201,168,76,0.03) 1px,
        transparent 1px,
        transparent 20px
      );
    }

    .play-btn {
      width: 72px;
      height: 72px;
      border: 2px solid var(--gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s;
      position: relative;
      z-index: 2;
    }
    .play-btn svg { width: 24px; height: 24px; fill: var(--gold); margin-left: 4px; }

    .video-label {
      position: absolute;
      bottom: 24px;
      left: 24px;
      right: 24px;
      z-index: 2;
    }
    .video-label .vtag {
      font-size: 10px;
      letter-spacing: 0.2em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .video-label .vtitle {
      font-family: 'DM Serif Display', serif;
      font-size: 20px;
      color: var(--text);
    }

    /* TOPICS GRID */
    .topics-section { background: var(--bg); }
    .topics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      margin-top: 60px;
      background: rgba(201,168,76,0.1);
    }
    .topic-card {
      background: var(--bg2);
      padding: 40px 36px;
      transition: background 0.3s;
      cursor: default;
    }
    .topic-card:hover { background: var(--bg3); }
    .topic-icon {
      font-size: 32px;
      margin-bottom: 20px;
    }
    .topic-name {
      font-family: 'DM Serif Display', serif;
      font-size: 22px;
      color: var(--text);
      margin-bottom: 12px;
    }
    .topic-desc {
      font-size: 12px;
      line-height: 1.8;
      color: var(--muted);
    }

    /* TIKTOK CTA */
    .tiktok-section {
      background: linear-gradient(135deg, #090b0e 0%, #0e1117 50%, #0a0f0a 100%);
      text-align: center;
      padding: 120px 48px;
      position: relative;
      overflow: hidden;
    }
    .tiktok-section::before {
      content: '@armiamaforex';
      position: absolute;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 180px;
      color: rgba(201,168,76,0.04);
      white-space: nowrap;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      letter-spacing: 0.02em;
    }
    .tiktok-handle {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(48px, 8vw, 96px);
      color: var(--gold);
      letter-spacing: 0.05em;
      position: relative;
      z-index: 2;
    }
    .tiktok-sub {
      font-size: 13px;
      color: var(--muted);
      margin: 16px 0 40px;
      letter-spacing: 0.1em;
      position: relative;
      z-index: 2;
    }
    .tiktok-btn {
      background: transparent;
      border: 2px solid var(--gold);
      color: var(--gold);
      font-family: 'DM Mono', monospace;
      font-size: 13px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 16px 48px;
      text-decoration: none;
      display: inline-block;
      transition: all 0.3s;
      position: relative;
      z-index: 2;
    }
    .tiktok-btn:hover {
      background: var(--gold);
      color: #090b0e;
      box-shadow: 0 0 48px rgba(201,168,76,0.4);
    }

    /* FOOTER */
    footer {
      padding: 32px 48px;
      border-top: 1px solid rgba(201,168,76,0.12);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    footer .logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 22px;
      color: var(--gold);
      letter-spacing: 0.08em;
    }
    footer .copy {
      font-size: 10px;
      color: var(--muted);
      letter-spacing: 0.15em;
    }
    footer .disclaimer {
      font-size: 9px;
      color: rgba(122,117,105,0.5);
      max-width: 340px;
      line-height: 1.7;
      text-align: right;
    }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    /* SCROLLBAR */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--gold); }

    /* RESPONSIVE */
    .nav-burger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
      z-index: 200;
    }
    .nav-burger span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--gold);
      transition: transform .25s, opacity .25s;
    }
    .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-burger.open span:nth-child(2) { opacity: 0; }
    .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    @media (max-width: 900px) {
      nav { padding: 14px 20px; }
      .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #0d0f13;
        border-top: 1px solid rgba(201,168,76,0.3);
        border-bottom: 1px solid rgba(201,168,76,0.3);
        box-shadow: 0 24px 48px rgba(0,0,0,0.5);
        flex-direction: column;
        gap: 0;
        padding: 8px 20px 14px;
        z-index: 150;
      }
      .nav-links.open { display: flex; }
      .nav-links li { border-bottom: 1px solid rgba(201,168,76,0.14); }
      .nav-links li:last-child { border-bottom: none; }
      .nav-links a {
        display: block;
        padding: 17px 4px;
        font-size: 15px;
        letter-spacing: 0.04em;
        text-transform: none;
        color: var(--text);
      }
      .nav-links a:hover, .nav-links a:active { color: var(--gold); }
      .nav-burger { display: flex; }

      /* SUBMENU mobile: accordion via tap, not hover */
      .has-submenu:hover .nav-submenu { display: none; }
      .has-submenu::after { display: none; }
      .nav-sub-toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 4px;
        font-size: 15px;
        letter-spacing: 0.04em;
        text-transform: none;
        color: var(--text);
      }
      .has-submenu.open .nav-sub-toggle { color: var(--gold); }
      .has-submenu.open .chevron { transform: rotate(180deg); }
      .has-submenu .nav-submenu {
        display: none;
        flex-direction: column;
        padding: 0 0 8px 16px;
      }
      .has-submenu.open .nav-submenu { display: flex; }
      .nav-submenu li { border-bottom: none; }
      .nav-submenu li a {
        padding: 12px 4px;
        font-size: 13.5px;
        color: var(--muted);
      }
      .nav-submenu li a:hover, .nav-submenu li a:active { color: var(--gold); }

      .nav-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.55);
        z-index: 140;
      }
      .nav-overlay.open { display: block; }
      .hero { grid-template-columns: 1fr; padding: 60px 24px; min-height: auto; }
      .stats-row { grid-template-columns: 1fr; }
      .stat-block { border-right: none; border-bottom: 1px solid rgba(201,168,76,0.15); padding: 36px; }
      section { padding: 72px 24px; }
      .content-grid { grid-template-columns: 1fr; gap: 40px; }
      .topics-grid { grid-template-columns: 1fr; }
      footer { flex-direction: column; gap: 16px; text-align: center; }
      footer .disclaimer { text-align: center; }
    }
  
    .shop-banner {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;
      background: var(--bg3);
      border-top: 1px solid var(--gold);
      box-shadow: 0 -8px 24px rgba(0,0,0,0.4);
      padding: 14px 56px 14px 24px;
      display: flex; align-items: center; justify-content: center;
      animation: shopBannerIn .4s ease;
    }
    @keyframes shopBannerIn { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .shop-banner-inner { display:flex; align-items:center; gap:20px; flex-wrap:wrap; justify-content:center; max-width: 900px; }
    .shop-banner-text { font-size: 12.5px; color: var(--text); }
    .shop-banner-cta {
      display:inline-block; background: var(--gold); color:#0a0b0d; font-weight:600;
      font-size:12px; letter-spacing:.03em; padding:9px 18px; border-radius:2px;
      text-decoration:none; white-space:nowrap; transition: background .2s;
    }
